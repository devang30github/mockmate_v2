APP_ENV=dev                     # dev | test | prod
PROVIDER_MODE=mock              # mock | live (prod refuses mock)
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mockmate:mockmate@localhost:5432/mockmate
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=mockmate_session
SESSION_TTL_HOURS=168
# Provider settings (leave keys empty in mock mode)
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=
APINEX_API_KEYS=            # comma-separated; one or more keys you are authorized to use
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEYS=            # comma-separated