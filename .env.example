APP_ENV=dev                     # dev | test | prod
PROVIDER_MODE=mock              # mock | live (prod refuses mock)
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://mockmate:mockmate@localhost:5432/mockmate
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=mockmate_session
SESSION_TTL_HOURS=168
# Provider settings (leave keys empty in mock mode)
APINEX_BASE_URL=https://api.apinex.bond/v1
APINEX_MODEL=
APINEX_API_KEYS=            # comma-separated; one or more keys you are authorized to use
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_API_KEYS=            # comma-separated

LLM_MODE=mock               # set to live to make the running app call APINex
APINEX_TIMEOUT_S=60
APINEX_MAX_ATTEMPTS=3
APINEX_JSON_MODE=prompt     # prompt | native (native sends response_format; verify support first)

STT_MODE=mock               # mock | local (local runs faster-whisper on this machine's CPU)
STT_MODEL=small
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=0
STT_BEAM_SIZE=1
STT_LANGUAGE=en
STT_VAD_FILTER=true

STT_LIVE_CAPTIONS=true
STT_PREVIEW_INTERVAL_S=1.5   # 0 = no live preview, phrase chunks only

STREAM_ASR_MODE=off          # off | sherpa (sherpa = live captions from a local streaming model)
STREAM_ASR_MODEL_DIR=models/sherpa-onnx-streaming-zipformer-en-2023-06-21
STREAM_ASR_THREADS=2